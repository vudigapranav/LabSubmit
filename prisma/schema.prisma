// Postgres, not SQLite: the app now runs on two hosts (Vercel serves the UI and API
// routes, Railway runs the execution engine) and both need to reach the same database
// over the network. A SQLite file lives on one machine's disk and cannot be shared.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  email      String?  @unique
  rollNumber String?  @unique
  password   String
  name       String
  role       String // ADMIN, LECTURER, STUDENT
  theme      String   @default("light") // light, dark
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Profile relations
  lecturerProfile LecturerProfile?
  studentProfile  StudentProfile?

  // Lecturer relations
  createdLabs          Lab[]        @relation("LecturerLabs")
  assignedSubjects     Subject[]    @relation("LecturerSubjects")
  evaluatedSubmissions Submission[] @relation("EvaluatedSubmissions")

  examAdminActions ExamAdminAction[] @relation("ExamAdminActions")
  // Student relations
  workspaces       LabWorkspace[]    @relation("StudentWorkspaces")
  submissions      Submission[]      @relation("StudentSubmissions")
  violations       ExamViolation[]
}

model LecturerProfile {
  id          String @id @default(uuid())
  userId      String @unique
  maxStudents Int    @default(60)
  department  String @default("Computer Science & Engineering")
  phone       String @default("")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Branch {
  id        String   @id @default(uuid())
  name      String // e.g. CSE-1, CSE-2, CSE-3, IT-1, IT-2, ECE-A, ECE-B
  year      Int // 1, 2, 3, 4
  rollStart String? // e.g. 160125733001
  rollEnd   String? // e.g. 160125733060
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentProfile[]
  subjects Subject[]
  labs     Lab[]
}

model Subject {
  id         String   @id @default(uuid())
  name       String // e.g. Java Programming Lab, Operating Systems Lab, DBMS Lab
  code       String // e.g. CS201L
  semester   Int? // e.g. 3, 4
  year       Int // 1, 2, 3, 4
  branchId   String
  lecturerId String? // Assigned Lecturer
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lecturer User?  @relation("LecturerSubjects", fields: [lecturerId], references: [id], onDelete: SetNull)
  labs     Lab[]
}

model StudentProfile {
  id         String  @id @default(uuid())
  userId     String  @unique
  rollNumber String  @unique // 1601XXXXXXXX
  year       Int // 1, 2, 3, 4
  branchId   String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

model Lab {
  id               String    @id @default(uuid())
  title            String
  description      String
  problemStatement String
  year             Int // 1, 2, 3, 4
  branchId         String?
  subjectId        String?
  lecturerId       String
  dueDate          DateTime?
  allowCopy        Boolean   @default(false)
  allowPaste       Boolean   @default(false)
  allowCut         Boolean   @default(false)
  allowRightClick  Boolean   @default(false)
  allowDragDrop    Boolean   @default(false)
  createdAt        DateTime  @default(now())

  // Exam scheduling
  examDate                DateTime?
  startTime               DateTime?
  endTime                 DateTime?
  durationMinutes         Int?
  allowedLanguages        String    @default("c,cpp,java,python") // CSV: c, cpp, java, python
  examModeEnabled         Boolean   @default(true)
  isPublished             Boolean   @default(false)
  fullscreenExitThreshold Int       @default(3)

  // Exam-device restriction. An active attempt may only be STARTED and continued from a
  // desktop-class device; dashboards, notices and results stay reachable from any device.
  // Enforced server-side from request headers (see src/lib/deviceEligibility.ts), never
  // from CSS or client-only checks.
  requireDesktopDevice Boolean @default(true)

  // Archive. An examination that students have actually sat can never be permanently
  // deleted — every relation below cascades, so a delete would take the workspaces,
  // submissions, awarded marks, integrity log, question sets and answer-sheet format with
  // it. Retiring such an exam sets this timestamp instead: nothing is destroyed, the exam
  // leaves every student-facing and active workflow (getExamStatus returns ARCHIVED, which
  // is not RUNNING, so no attempt can start or continue), and faculty keep full access for
  // historical review and evaluation. Null means "live", which is what every existing row
  // is, so the column is additive and changes no current behaviour.
  archivedAt DateTime?

  // Result release. Null means results for this examination have not been released, which
  // is what every existing row is and what every new exam starts as. Releasing sets this
  // timestamp and publishes the exam's graded submissions in the same transaction, so this
  // switch and Submission.isPublished can never disagree. Whether a newly saved evaluation
  // is published is derived from this field on the server — the client never decides it.
  resultsReleasedAt DateTime?

  lecturer            User                 @relation("LecturerLabs", fields: [lecturerId], references: [id], onDelete: Cascade)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  subject             Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  workspaces          LabWorkspace[]
  submissions         Submission[]
  violations          ExamViolation[]
  answerSheetSections AnswerSheetSection[]
  questionSets        QuestionSet[]
  adminActions        ExamAdminAction[]
}

model LabWorkspace {
  id          String    @id @default(uuid())
  labId       String
  studentId   String
  isSubmitted Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Exam mode tracking
  startedAt           DateTime? // set when the student clicks "Start Exam" — begins their personal countdown
  fullscreenExitCount Int       @default(0)
  autoSubmitted       Boolean   @default(false)
  sessionId           String? // active browser-session claim, for duplicate-session detection
  lastActivityAt      DateTime? // updated by the heartbeat endpoint while the exam is open

  // Question set randomly assigned by the server when the attempt starts. Deliberately
  // never surfaced to the student by name — they see only the statement it carries.
  questionSetId String?

  // Device class recorded at start_exam, for the audit trail (see deviceEligibility.ts).
  startDeviceClass String?
  startUserAgent   String?

  lab                  Lab                   @relation(fields: [labId], references: [id], onDelete: Cascade)
  student              User                  @relation("StudentWorkspaces", fields: [studentId], references: [id], onDelete: Cascade)
  questionSet          QuestionSet?          @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  files                LabFile[]
  submissions          Submission[]
  answerSheetResponses AnswerSheetResponse[]
  executionRecords     ExecutionRecord[]
}

model LabFile {
  id          String   @id @default(uuid())
  workspaceId String
  filename    String // e.g. main.c, solution.cpp, App.java, script.js
  content     String
  language    String // c, cpp, java, javascript
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace LabWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Submission {
  id          String    @id @default(uuid())
  labId       String
  studentId   String
  workspaceId String
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, NEEDS_CORRECTION
  marks       Float?
  maxMarks    Float     @default(100.0)
  remarks     String?
  isPublished Boolean   @default(false)
  submittedAt DateTime  @default(now())
  evaluatedAt DateTime?
  evaluatorId String?

  lab                Lab                 @relation(fields: [labId], references: [id], onDelete: Cascade)
  student            User                @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  workspace          LabWorkspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evaluator          User?               @relation("EvaluatedSubmissions", fields: [evaluatorId], references: [id], onDelete: SetNull)
  sectionEvaluations SectionEvaluation[]
}

model ExamViolation {
  id        String   @id @default(uuid())
  labId     String
  studentId String
  type      String // FULLSCREEN_EXIT, FULLSCREEN_ENTER, WINDOW_BLUR, VISIBILITY_HIDDEN, DEVTOOLS_ATTEMPT,
  // COPY_ATTEMPT, CUT_ATTEMPT, PASTE_ATTEMPT, CONTEXT_MENU_ATTEMPT, SELECT_ALL_ATTEMPT,
  // DUPLICATE_SESSION, EXAM_TIMEOUT — see src/lib/examIntegrity.ts for the severity mapping
  severity  String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL — server-computed, never client-supplied
  details   String?
  createdAt DateTime @default(now())

  lab     Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([labId, studentId])
  @@index([labId])
}

// ---------------------------------------------------------------------------
// Unified digital answer sheet
//
// ONE examination model, not several formats: every exam uses the same answer
// sheet, and the lecturer decides which of its sections are switched on, in what
// order, under what label, whether each is mandatory, and what it is worth. A lab
// with no rows here behaves exactly as before this model existed — code-only —
// so every pre-existing exam keeps working untouched.
// ---------------------------------------------------------------------------

model AnswerSheetSection {
  id       String  @id @default(uuid())
  labId    String
  key      String // AIM, DESCRIPTION, ALGORITHM, PROCEDURE, CODE, INPUT, OUTPUT, CONCLUSION, ITERATION
  label    String // lecturer-editable display heading, e.g. "Aim / Objective"
  order    Int // ascending render order
  enabled  Boolean @default(true)
  required Boolean @default(false)
  maxMarks Float? // optional per-section weighting; null = not separately weighted

  // Where this section's content comes from:
  //   TEXT          — the student writes it in the answer sheet
  //   CODE_FILES    — satisfied by the workspace's source files (the IDE), not a textarea
  //   EXECUTION_IO  — the input fed to / output produced by a program run
  contentSource String @default("TEXT")

  lab         Lab                   @relation(fields: [labId], references: [id], onDelete: Cascade)
  responses   AnswerSheetResponse[]
  evaluations SectionEvaluation[]

  @@unique([labId, key])
  @@index([labId])
}

model AnswerSheetResponse {
  id          String   @id @default(uuid())
  workspaceId String
  sectionId   String
  content     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace LabWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section   AnswerSheetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sectionId])
  @@index([workspaceId])
}

// A lecturer authors several sets per exam; the server picks one at random when a
// student starts their attempt and pins it to that workspace. Falls back to
// Lab.problemStatement when an exam has no sets, so existing exams are unaffected.
model QuestionSet {
  id        String   @id @default(uuid())
  labId     String
  label     String // e.g. "Set A" — faculty-facing only, never shown to students
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lab        Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  questions  Question[]
  workspaces LabWorkspace[]

  @@index([labId])
}

// A set holds as many questions as the lecturer chooses. Questions live in their own rows
// rather than as one blob on the set, so a set's size is lecturer-defined and each question
// can carry its own marks. Deliberately NOT called a "problem statement": Lab.problemStatement
// remains the single-question fallback for exams with no sets, and the two must not be
// conflated.
model Question {
  id            String   @id @default(uuid())
  questionSetId String
  order         Int
  text          String
  marks         Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  questionSet QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)

  @@index([questionSetId])
}

// One persisted record per program run during an attempt: what was compiled, what was
// typed into it, and what it printed — the evidence an evaluator needs to judge the
// Input and Output sections of the answer sheet.
model ExecutionRecord {
  id            String   @id @default(uuid())
  workspaceId   String
  filename      String
  language      String
  stdin         String   @default("")
  stdout        String   @default("")
  exitCode      Int?
  durationMs    Int?
  compileFailed Boolean  @default(false)
  createdAt     DateTime @default(now())

  workspace LabWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Per-section marks. Submission.marks stays the authoritative total the student sees;
// these rows are the breakdown behind it.
model SectionEvaluation {
  id           String   @id @default(uuid())
  submissionId String
  sectionId    String
  marks        Float?
  remarks      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  section    AnswerSheetSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sectionId])
  @@index([submissionId])
}

// Administrative actions taken against a live examination — generating assignments,
// reassigning a student's set, or editing a question set students are already sitting.
//
// These are the operations the platform normally refuses. Where a lecturer is permitted to
// override that refusal, the override is recorded here rather than happening silently, so
// an examiner can later answer "who changed this paper, and when?".
model ExamAdminAction {
  id String @id @default(uuid())

  // Nullable, and SetNull rather than Cascade: the record of a deletion must outlive the
  // thing it records. Under the previous Cascade the one audit row that mattered most —
  // "this exam was permanently deleted" — was destroyed by the very delete it documented.
  // Widening the column (dropping NOT NULL) leaves every existing row valid.
  labId String?

  // Snapshot of the exam's title at the time of the action, so a row whose labId has been
  // nulled by a deletion still names what went.
  labTitle String?

  actorId   String
  action    String // GENERATE_ASSIGNMENTS, REASSIGN_SET, EDIT_LIVE_QUESTION_SET, ARCHIVE_EXAM, UNARCHIVE_EXAM, DELETE_EXAM, RELEASE_RESULTS
  details   String
  createdAt DateTime @default(now())

  lab   Lab? @relation(fields: [labId], references: [id], onDelete: SetNull)
  actor User @relation("ExamAdminActions", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([labId])
}
